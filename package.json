{
  "name": "deepa-quest",
  "private": true,
  "version": "2.0.0",
  "description": "A mobile-first game about why Diwali is celebrated across India and the world.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
