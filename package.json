    "spec:validate": "openspec validate --all --strict"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "solid-js": "^1.9.18"
  },
  "devDependencies": {
    "@fission-ai/openspec": "^1.16.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.6",
    "vite-plugin-solid": "^2.11.15"
  }
}
